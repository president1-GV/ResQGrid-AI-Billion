# ============================================================
# RESQGRID AI - ENVIRONMENT CONFIGURATION TEMPLATE
# INTELLIGENCE FOR EVERY RESPONSE.
# ============================================================

# Environment: development | staging | production
ENVIRONMENT=development

# Server Ports
PORT=8000
FRONTEND_PORT=5173

# Database & Spatial Engine (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://resqgrid_user:resqgrid_pass@localhost:5432/resqgrid_db
POSTGRES_USER=resqgrid_user
POSTGRES_PASSWORD=resqgrid_pass
POSTGRES_DB=resqgrid_db

# Cache & Event Streaming (Redis)
REDIS_URL=redis://localhost:6379/0

# Geospatial Routing (OSRM - Leave empty to use built-in OfflineDemoRoutingService)
OSRM_URL=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & RBAC
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
